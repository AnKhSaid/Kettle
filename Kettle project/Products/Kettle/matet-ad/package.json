{
  "name": "matet-ad",
  "version": "1.0.0",
  "description": "MATET smart mate kettle — 30 s Arabic vertical ad, made with Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "@remotion/cli": "4.0.529",
    "@remotion/effects": "4.0.529",
    "@remotion/fonts": "4.0.529",
    "@remotion/layout-utils": "4.0.529",
    "@remotion/media": "4.0.529",
    "@remotion/motion-blur": "4.0.529",
    "@remotion/noise": "4.0.529",
    "@remotion/paths": "4.0.529",
    "@remotion/rough-notation": "4.0.529",
    "@remotion/shapes": "4.0.529",
    "@remotion/three": "4.0.529",
    "@remotion/transitions": "4.0.529",
    "@types/three": "0.186.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.529",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.529",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "audio": "python3 tools/prepare_audio.py",
    "stills": "node tools/stills.mjs",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:1": "remotion render Option1-Story out/option-1-story-raw.mp4 --codec=h264 --crf=17 --audio-bitrate=256k",
    "video:1": "npm run render:1 && node tools/master.mjs out/option-1-story-raw.mp4 option-1-story.mp4",
    "render:2": "remotion render Option2-Illustrated out/option-2-illustrated-raw.mp4 --codec=h264 --crf=17 --audio-bitrate=256k",
    "video:2": "npm run render:2 && node tools/master.mjs out/option-2-illustrated-raw.mp4 option-2-illustrated.mp4",
    "render:3": "remotion render Option3-Product out/option-3-product-raw.mp4 --codec=h264 --crf=17 --audio-bitrate=256k",
    "video:3": "npm run render:3 && node tools/master.mjs out/option-3-product-raw.mp4 option-3-product.mp4"
  },
  "sideEffects": [
    "*.css"
  ]
}
